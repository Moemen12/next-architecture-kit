{
  "name": "next-architecture-kit",
  "version": "0.1.0",
  "description": "A pragmatic feature-based and Clean Architecture starter for Next.js App Router projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "next-architecture": "./dist/cli/index.js"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.cli.json",
    "kit:status": "npm run build:cli && node ./dist/cli/index.js status",
    "kit:preview": "npm run build:cli && node ./dist/cli/index.js upgrade --preview"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3"
  }
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.next/**",
      "!!out/**",
      "!!build/**",
      "!!coverage/**",
      "!!reports/**",
      "!!node_modules/**",
      "!!public/**/*.ico"
    ]
  }
}

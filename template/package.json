{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:runtime": "tsx scripts/check-runtime.ts",
    "secrets": "tsx scripts/check-staged-secrets.ts",
    "server-only:check": "tsx scripts/check-server-only.ts",
    "public-imports:check": "tsx scripts/check-public-imports.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format . --error-on-warnings",
    "architecture": "dependency-cruiser --config .dependency-cruiser.mjs src",
    "validate": "npm run check:runtime && npm run format:check && npm run lint && npm run typecheck && npm run architecture && npm run server-only:check && npm run public-imports:check && npm run secrets && npm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "secretlint": "13.0.4",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.20.5",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run secrets"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.2"
}
